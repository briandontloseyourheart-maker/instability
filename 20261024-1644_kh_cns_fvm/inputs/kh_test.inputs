# Small, fast test: 64^2 base grid + 2 levels (effective 256^2).
max_step  = 100000
stop_time = 0.2

amr.n_cell        = 64 64
amr.max_level     = 2
amr.max_grid_size = 32
amr.plot_int      = 50
amr.checkpoint_files_output = 0

# refine where the density jumps by more than this between neighbours
cns.refine_max_dengrad_lev = 10
cns.refine_dengrad         = 0.05

prob.delta = 0.01

geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0
geometry.is_periodic = 1 1

# all-regular EB geometry: no embedded walls, plain Cartesian box
eb2.geom_type = all_regular

# BC flags (0 = interior/periodic)
cns.lo_bc = 0 0
cns.hi_bc = 0 0

cns.eos_gamma       = 1.6666666666666667
cns.cfl             = 0.3
cns.do_visc         = 0
cns.do_reflux       = 1
cns.refine_cutcells = 0
cns.v               = 0

amr.ref_ratio       = 2 2 2 2 2 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.n_error_buf     = 2
# proper-nesting buffer between AMR levels (coarse cells). The default of 1
# left ghost cells in corners across the periodic boundary unfilled on deep
# hierarchies (NaN at t ~ 0.62 with 6 levels); 2 fixes it.
amr.n_proper        = 2
amr.grid_eff        = 0.7
amr.v               = 1

amr.plot_files_output = 1
amr.plot_file         = plt
amr.derive_plot_vars  = pressure x_velocity y_velocity

prob.rho_in  = 2.0
prob.rho_out = 1.0
prob.v_in    = 0.5
prob.v_out   = -0.5
prob.p0      = 2.5
prob.w0      = 0.1
